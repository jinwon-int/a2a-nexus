  "conformanceCategories": [
    {
      "id": "claim-poll",
      "name": "Claim and poll work acquisition",
      "contractRef": "contracts/a2a/platform-adapter-interface.md#31-a2aadapter-interface",
      "passCriteria": [
        "Adapter supports http-poll discovery of pending assigned tasks.",
        "Adapter claims before task execution and can classify claim refusal without side effects.",
        "Adapter treats duplicate delivery as at-least-once and relies on idempotency keys."
      ]
    },
    {
      "id": "report-status",
      "name": "Report standard task status",
      "contractRef": "contracts/a2a/platform-adapter-interface.md#24-a2ataskstatus",
      "passCriteria": [
        "Adapter reports claimed/running and one terminal status using the standard vocabulary.",
        "Adapter does not infer operator ACK from status-report acceptance.",
        "Adapter observes cancellation responses before further mutable work."
      ]
    },
    {
      "id": "heartbeat",
      "name": "Heartbeat health signal",
      "contractRef": "contracts/a2a/platform-adapter-interface.md#26-a2aheartbeat",
      "passCriteria": [
        "Adapter sends health and active task metadata through the broker heartbeat route.",
        "Heartbeat payload is redacted and contains no runtime-specific private path material.",
        "Heartbeat failure is classified as degraded/unavailable rather than hidden."
      ]
    },
    {
      "id": "terminal-evidence",
      "name": "Terminal evidence shape",
      "contractRef": "contracts/a2a/platform-adapter-interface.md#25-a2aevidence",
      "passCriteria": [
        "Adapter submits start, PR, Done, or Block evidence in the common evidence envelope.",
        "Evidence acceptance is non-ACK receipt evidence only.",
        "Evidence is compact enough for public issue/PR comments."
      ]
    },
    {
      "id": "idempotency-dedupe",
      "name": "Idempotency and dedupe",
      "contractRef": "contracts/a2a/platform-adapter-interface.md#32-core-contract-guarantees",
      "passCriteria": [
        "Repeated claim/status/evidence calls with the same key return the existing result.",
        "Same key with conflicting payload is a conflict, not an overwrite.",
        "Dedupe never creates duplicate terminal evidence or duplicate sends."
      ]
    },
    {
      "id": "fail-closed-redaction",
      "name": "Fail-closed redaction",
      "contractRef": "contracts/a2a/platform-adapter-interface.md#8-safety-boundaries",
      "passCriteria": [
        "Unredacted evidence is blocked before broker/provider submission.",
        "Classified block evidence reports only safe reason codes.",
        "Runtime bootstrap context and host-private state are excluded from evidence."
      ]
    }
  ],
