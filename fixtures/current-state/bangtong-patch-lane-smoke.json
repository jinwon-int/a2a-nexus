{
  "schema": "a2a.bangtong.patch-lane-smoke.v1",
  "mode": "no-live",
  "parentIssue": "https://github.com/jinwon-int/a2a-nexus/issues/1022",
  "snapshotDate": "2026-06-24",
  "description": "Bangtong GitHub patch lane smoke fixture. Proves that bangtong can claim github-propose-patch and create a valid PR via the A2A docker-runner. Source-only fixture with no live broker/Gateway/worker boundaries.",
  "sourceOnly": true,
  "finalizerRequired": true,
  "worker": {
    "workerId": "bangtong",
    "runtime": "hermes-agent",
    "harness": "hermes",
    "workerMode": "persistent",
    "capabilityUnderTest": "github-propose-patch",
    "brokerBoundary": "Seoseo broker-backed task, PR-first only"
  },
  "noLiveBoundaries": {
    "deploy": false,
    "restart": false,
    "dbMutation": false,
    "terminalAckReplay": false,
    "providerSend": false,
    "telegramSend": false,
    "secretMovement": false
  },
  "expectedFinalizerAction": "finalizer validates PR and updates Family Wiki; worker must not close the issue or merge the PR",
  "boundary": {
    "liveA2ADispatch": false,
    "providerSend": false,
    "telegramSend": false,
    "dbMutation": false,
    "terminalAckReplay": false,
    "deployRestart": false,
    "gatewayRestart": false,
    "credentialMovement": false,
    "issueMutationByWorker": false,
    "repoVisibilityChange": false,
    "releaseTagNpmDockerPublish": false,
    "forcePushOrHistoryRewrite": false,
    "destructiveCheckoutCleanup": false
  },
  "acceptance": {
    "prAgainstMain": true,
    "sourceDocsFixturesOnly": true,
    "noRawSecrets": true,
    "noLocalEnvOrSessionDumps": true,
    "existingChecksPassOrExactBlockerEvidence": true,
    "startPrDoneBlockEvidenceInComments": true
  },
  "replaySafe": true
}
