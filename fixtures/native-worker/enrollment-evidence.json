  "androidTermuxCaveats": {
    "enrollmentWakeLock": "Enrollment health checks should verify termux-wake-lock is active before production broker contact",
    "enrollmentNetwork": "If using Tailscale/VPN for broker reachability, verify tunnel stability for at least 60 minutes",
    "enrollmentBattery": "Production broker polling may increase battery drain vs loopback; verify acceptable drain",
    "enrollmentStorage": "Enrollment evidence packets must use 0700 permissions; do not use shared storage",
    "bootAfterEnrollment": "Verify Termux:Boot sources updated env file after reboot"
  }
}
