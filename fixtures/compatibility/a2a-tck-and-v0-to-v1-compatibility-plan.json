  "v0ToV1Rules": [
    {
      "id": "additive",
      "title": "Additive only",
      "policy": "v0→v1 may add new optional fields, new lifecycle states that do not change existing transitions, new optional capability labels, or new harness-neutral evidence classes. Additive changes never remove or rename frozen fields, and default behaviour must not change.",
      "evidenceContracts": [
        "contracts/compatibility/a2a-tck-and-v0-to-v1-compatibility-plan.md"
      ]
    },
    {
      "id": "deprecation",
      "title": "Deprecations are explicit and time-bounded",
      "policy": "Deprecated fields must remain parsable and emit a documented warning for at least one minor version cycle before removal. A removal PR must include a deprecation commit and a migration note listing every consumer. Deprecation entries land in contracts/compatibility/matrix.md with a removal gate version.",
      "evidenceContract": "contracts/compatibility/matrix.md"
    },
    {
      "id": "schema-versioning",
      "title": "Schema versioning requires a major version bump for breaking changes",
      "policy": "Breaking changes require a major version bump even within a 0.x release train. Frozen contracts carry an explicit v0Freeze.frozenAt marker. New schemas add a new fixture with a distinct fixtureId and keep the v0 fixture unchanged until deprecation closes.",
      "evidenceContracts": [
        "contracts/compatibility/a2a-tck-and-v0-to-v1-compatibility-plan.md",
        "contracts/compatibility/matrix.md"
      ]
    },
    {
      "id": "worker-capability",
      "title": "Worker capability evolution stays additive and public-safe",
      "policy": "New workloadStrengths labels are additive and may land in a minor version. Removing or renaming a label is a breaking change and triggers the schema versioning rule. The freshnessTimestamp field and stale-profile handling are frozen; any change ships with a new fixture. Profiles must remain public-safe (no host names, private paths, provider tokens, raw session dumps, or runtime/bootstrap context file names).",
      "evidenceContract": "contracts/a2a/worker-capability-profile.md"
    },
    {
      "id": "terminal-evidence",
      "title": "Terminal evidence semantics lock the accepted-send non-ACK boundary",
      "policy": "The four receipt levels (accepted-send, requester-visible, operator-visible, terminal ACK) and the three result types (Done, PR, Block) are frozen. providerMessageId, providerAccepted, sendStatus: accepted, sendStatus: sent, queue_accepted, and spool_produced are never terminal ACK evidence. Only manual_operator_receipt and current_session_visible are ACK-safe receipt proofs. Terminal ACK is not derivable from provider delivery responses.",
      "evidenceContracts": [
        "contracts/a2a/terminal-semantics.md",
        "contracts/compatibility/terminal-evidence-ack-boundary.md"
      ]
    }
  ],
