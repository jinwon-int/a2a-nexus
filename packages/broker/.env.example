# Broker HTTP identity
PORT=8787
HOST=0.0.0.0
SERVICE_NAME=a2a-broker
# Replace this placeholder before startup; broker boot fails fast if left masked.
PUBLIC_BASE_URL=http://<masked-host>:8787

# Broker durable identity and team ownership
A2A_BROKER_ID=
# Legacy alias for A2A_BROKER_ID
BROKER_ID=
A2A_TEAM_ID=

# Broker build metadata surfaced by /health and /dashboard
A2A_BROKER_VERSION=
A2A_BROKER_REVISION=
# Legacy revision aliases, checked after A2A_BROKER_REVISION
BROKER_RELEASE_REVISION=
RELEASE_REVISION=
A2A_BROKER_SOURCE=
A2A_BROKER_BUILT_AT=
A2A_BROKER_RUNTIME=
# Optional OCI image metadata (safe compact values only)
A2A_BROKER_IMAGE_TAG=
A2A_BROKER_IMAGE_DIGEST=

# Broker persistence
STATE_FILE=/var/lib/a2a-broker/state.json
STATE_FILE_MAX_BYTES=
BROKER_PERSISTENCE_BACKEND=json-file
BROKER_SQLITE_FILE=/var/lib/a2a-broker/state.sqlite
# Compatibility alias for BROKER_SQLITE_FILE; takes precedence when set.
SQLITE_STATE_FILE=
# snapshot (default) or hot-tables
BROKER_SQLITE_LOAD_SOURCE=snapshot
# Opt-in worker-thread durable write queue for SQLite. Default is inline main-thread writes.
# When enabled, mutating HTTP routes wait for the worker-thread ACK before success.
BROKER_PERSISTENCE_QUEUE_WORKER_THREAD=0
# Max ACK wait before a mutating route fails closed with retryable 503 queue_drain_timeout.
BROKER_PERSISTENCE_QUEUE_ACK_TIMEOUT_MS=30000
# Runtime hot-table hydration caps for loadSource=hot-tables. Active tasks always hydrate;
# these caps bound historical terminal tasks, audit events, and terminal outbox rows in heap.
BROKER_HOT_RUNTIME_MAX_TERMINAL_TASKS=2000
BROKER_HOT_RUNTIME_MAX_AUDIT_EVENTS=5000
BROKER_HOT_RUNTIME_MAX_HEARTBEAT_AUDIT_EVENTS=500
BROKER_HOT_RUNTIME_MAX_TERMINAL_OUTBOX_EVENTS=1000

# Broker request security, rate limits, and stale-task recovery
WORKER_OFFLINE_AFTER_SEC=90
# Minimum durable unchanged-worker heartbeat write interval in milliseconds.
# Default is disabled; in-memory worker liveness still updates on every heartbeat.
# Set 0 to persist every heartbeat, or a positive interval to persist periodic unchanged heartbeats.
BROKER_WORKER_HEARTBEAT_PERSIST_INTERVAL_MS=
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=10
WORKER_RATE_LIMIT_WINDOW_SEC=60
WORKER_RATE_LIMIT_MAX_REQUESTS=60
ENFORCE_REQUESTER_IDENTITY=1
TRUSTED_PROXY=0
EDGE_SECRET=
# Replace with a shared secret (32+ random chars); retain unchanged during rotation prep.
# Use the same value on all workers via BROKER_EDGE_SECRET.
# Compatibility alias for broker edge auth
A2A_EDGE_SECRET=
# Worker-plane A2A HTTP Signature rollout mode: off | optional | strict.
# Default off preserves legacy edge-secret/requester-header compatibility.
A2A_HTTP_SIGNATURE_WORKER_AUTH=off
# JSON file of public worker HTTP Signature keys only. Do not put private keys or secrets here.
# Shape: { "worker:<id>:v1": { "keyid": "worker:<id>:v1", "workerId": "<id>", "publicKeyJwk": { "kty": "OKP", "crv": "Ed25519", "x": "..." } } }
A2A_HTTP_SIGNATURE_KEY_REGISTRY_FILE=
# Shared secret for GitHub webhook deliveries (Settings > Webhooks > Secret).
# When set, POST /github/webhook requires a valid X-Hub-Signature-256 header
# (HMAC-SHA256 of the raw body); deliveries without it are rejected.
# Set EITHER this or the alias below — a blank value here falls through to the
# alias rather than disabling verification.
GITHUB_WEBHOOK_SECRET=
# Compatibility alias for the GitHub webhook secret
A2A_GITHUB_WEBHOOK_SECRET=
STALE_REAPER_ENABLED=1
STALE_REAPER_INTERVAL_SEC=60
STALE_REAPER_OLDER_THAN_SEC=90
BROKER_MAX_REQUEUE_ATTEMPTS=5
TASK_SUBSCRIBE_HEARTBEAT_SEC=15
A2A_PEER_STATUS_ENABLED=0
# HTTP keep-alive tuning. Defaults are chosen to keep broker-side worker
# heartbeats on reused sockets while keeping headers timeout above keep-alive.
A2A_SERVER_KEEPALIVE_TIMEOUT_MS=
A2A_SERVER_HEADERS_TIMEOUT_MS=

# Broker retention policy overrides
BROKER_TERMINAL_RETENTION_MS=
BROKER_MAX_TERMINAL_EXCHANGES=
BROKER_MAX_TERMINAL_TASKS=
BROKER_MAX_TERMINAL_PROPOSALS=
BROKER_INACTIVE_WORKER_RETENTION_MS=
BROKER_MAX_INACTIVE_WORKERS=
BROKER_AUDIT_RETENTION_MS=
BROKER_MAX_AUDIT_EVENTS=
BROKER_MAX_HEARTBEAT_AUDIT_EVENTS=
BROKER_HEARTBEAT_AUDIT_SAMPLE_INTERVAL_MS=

# Brokersqlite hot-table load limits (loadSource=hot-tables only)
# Caps the rows hydrated into Node heap at startup. Defaults:
#   non-terminal: 500, terminal: 2000, audit: 5000, heartbeat-audit: 500, terminal-outbox: 1000
BROKER_HOT_RUNTIME_MAX_NON_TERMINAL_TASKS=
BROKER_HOT_RUNTIME_MAX_TERMINAL_TASKS=
BROKER_HOT_RUNTIME_MAX_AUDIT_EVENTS=
BROKER_HOT_RUNTIME_MAX_HEARTBEAT_AUDIT_EVENTS=
BROKER_HOT_RUNTIME_MAX_TERMINAL_OUTBOX=

# Worker daemon broker connection
BROKER_URL=http://127.0.0.1:8787
# Compatibility alias for BROKER_URL
A2A_BROKER_URL=
# Worker client edge-secret lookup order: BROKER_EDGE_SECRET, A2A_BROKER_EDGE_SECRET, EDGE_SECRET, A2A_EDGE_SECRET.
BROKER_EDGE_SECRET=
# Must match the broker-side EDGE_SECRET. Rotate both sides in lockstep.
A2A_BROKER_EDGE_SECRET=

# Worker home-broker pinning; fail closed unless /health brokerId matches.
A2A_HOME_BROKER_ID=
HOME_BROKER_ID=
A2A_HOME_BROKER_LEASE_FILE=
HOME_BROKER_LEASE_FILE=
# Optional per-worker A2A HTTP Signature signing for broker control-plane requests.
# Private key material belongs on the worker only; broker receives the matching public JWK via A2A_HTTP_SIGNATURE_KEY_REGISTRY_FILE.
A2A_HTTP_SIGNATURE_WORKER_KEY_ID=
WORKER_HTTP_SIGNATURE_KEY_ID=
A2A_HTTP_SIGNATURE_WORKER_PRIVATE_KEY_JWK=
WORKER_HTTP_SIGNATURE_PRIVATE_KEY_JWK=
A2A_HTTP_SIGNATURE_BROKER_ID=
WORKER_HTTP_SIGNATURE_BROKER_ID=

# Worker identity and advertised metadata
WORKER_ID=worker-a
A2A_WORKER_ID=
NODE_ID=
WORKER_ROLE=analyst
A2A_WORKER_ROLE=
WORKER_REQUESTER_KIND=node
A2A_WORKER_REQUESTER_KIND=
WORKER_DISPLAY_NAME=
A2A_WORKER_DISPLAY_NAME=
WORKER_PUBLIC_URL=
A2A_WORKER_PUBLIC_URL=
WORKER_METADATA_JSON=
A2A_WORKER_METADATA_JSON=
WORKER_USER_AGENT=
A2A_WORKER_USER_AGENT=
# OpenClaw poll-only profile: OpenClaw-node only. Broker HTTP poll/claim/complete
# + stdin/stdout handler, no Gateway bridge. Hermes nodes should declare
# WORKER_RUNTIME_FLAVOR=termux-hermes and use a Hermes harness, not this profile.
WORKER_PROFILE=
A2A_WORKER_PROFILE=

# Worker handler configuration
WORKER_HANDLER_BUILTIN=echo
A2A_WORKER_HANDLER_BUILTIN=
WORKER_HANDLER_COMMAND=
A2A_WORKER_HANDLER_COMMAND=
WORKER_HANDLER_ARGS_JSON=
A2A_WORKER_HANDLER_ARGS_JSON=
WORKER_HANDLER_CWD=
A2A_WORKER_HANDLER_CWD=
WORKER_HANDLER_TIMEOUT_MS=60000
A2A_WORKER_HANDLER_TIMEOUT_MS=
WORKER_POLL_INTERVAL_MS=5000
A2A_WORKER_POLL_INTERVAL_MS=
# Probe the assigned-task poll path once at startup and fail loudly if it is
# unreachable or unauthorized (register/heartbeat passing does not prove the
# worker can receive work). Default on; set to off/false to skip.
WORKER_POLL_READINESS_PROBE=on
A2A_WORKER_POLL_READINESS_PROBE=
WORKER_HEARTBEAT_INTERVAL_MS=30000
A2A_WORKER_HEARTBEAT_INTERVAL_MS=
# Per-request HTTP timeout (ms) for the worker's broker calls. Bounds a hung
# connection so one stalled request cannot freeze the poll loop. Default 30000.
WORKER_REQUEST_TIMEOUT_MS=30000
A2A_WORKER_REQUEST_TIMEOUT_MS=

# Optional model-backed read-only analysis bridge. Leave disabled unless the
# operator explicitly wants analyze/analysis-only tasks to call a real LLM.
A2A_OPENCLAW_ANALYSIS_ENABLED=0
A2A_OPENCLAW_ANALYSIS_DISABLED=
A2A_OPENCLAW_BRIDGE_ENABLED=
A2A_OPENCLAW_BRIDGE_DISABLED=
# Optional analysis-only bridge binary. Prefer this over changing OPENCLAW_BIN
# so propose_patch / decision.dialectic bridge paths keep their existing runtime.
A2A_OPENCLAW_ANALYSIS_BIN=
OPENCLAW_BIN=
HERMES_BIN=hermes
A2A_HERMES_ANALYSIS_TOOLSETS=safe
A2A_HERMES_ANALYSIS_MODEL=
A2A_HERMES_ANALYSIS_TIMEOUT_SEC=300
A2A_ANALYSIS_REPO_MAP_JSON=
A2A_HERMES_ANALYSIS_REPO_ROOT=
A2A_HERMES_ANALYSIS_MAX_FILES=16
A2A_HERMES_ANALYSIS_MAX_FILE_BYTES=24576
A2A_HERMES_ANALYSIS_MAX_TOTAL_BYTES=163840

# Worker capabilities; WORKER_CAPABILITIES_JSON overrides individual capability flags when set.
WORKER_CAPABILITIES_JSON=
A2A_WORKER_CAPABILITIES_JSON=
WORKER_CAN_ANALYZE=1
A2A_WORKER_CAN_ANALYZE=
WORKER_CAN_BACKFILL=0
A2A_WORKER_CAN_BACKFILL=
WORKER_CAN_PATCH_WORKSPACE=0
A2A_WORKER_CAN_PATCH_WORKSPACE=
WORKER_CAN_PROMOTE_LIVE=0
A2A_WORKER_CAN_PROMOTE_LIVE=
WORKER_WORKSPACE_IDS=test
A2A_WORKER_WORKSPACE_IDS=
WORKER_ENVIRONMENTS=research
A2A_WORKER_ENVIRONMENTS=
# Hermes/native worker: set to "termux-hermes" to declare lightweight runtime (no full Gateway)
WORKER_RUNTIME_FLAVOR=
A2A_WORKER_RUNTIME_FLAVOR=
# Hermes/native worker: set to "false" when no full OpenClaw Gateway runs on-device
WORKER_GATEWAY_REQUIRED=
A2A_WORKER_GATEWAY_REQUIRED=
# Worker operating mode: "persistent" (default) or "mobile" (Hermes/battery-powered, shorter stale window)
WORKER_MODE=
A2A_WORKER_MODE=

# --- A2A 1.0 signed agent cards (optional) ---------------------------------
# PEM private key file (Ed25519 or EC P-256). When set, the served
# /.well-known/agent-card.json carries a JWS signature over the RFC 8785
# canonicalized card. Leave unset to serve the card unsigned.
AGENT_CARD_SIGNING_KEY_FILE=
# Optional JWS kid header value for key identification/rotation.
AGENT_CARD_SIGNING_KID=

# --- A2A 1.0 push notifications (optional) ----------------------------------
# 1/true enables task push-notification config CRUD
# (Create/Get/List/Delete TaskPushNotificationConfig) and advertises
# capabilities.pushNotifications on the agent card. Registration only — it
# never performs a live send. Off by default.
A2A_PUSH_NOTIFICATIONS_ENABLED=

# --- Cross-broker sender-proof trust (optional) ------------------------------
# JSON file pinning peer broker public keys for the cross-broker terminal-
# brief receiver: { "<brokerId>": "<SPKI public key PEM>" }. When set,
# inbound projections must carry a request-bound senderProof (a JWS over
# { brokerId, bodyHash, issuedAt, nonce } signed by the pinned key) proving
# the sender holds the private key for THIS request — a static signed card is
# replayable and is not sufficient. Enabling the receiver side fail-closes
# peers that do not emit senderProof yet: roll out sender support first.
# Unset keeps the edge-secret-only behavior.
CROSS_BROKER_SENDER_PROOF_KEYS_FILE=

# --- Embedded default A2A agent (optional) ----------------------------------
# 1/true enables single-agent mode: the broker registers a built-in echo
# worker and drives its tasks in-process, so a worker-less SendMessage
# produces a completed task (A2A conformance / standalone-agent usage).
# Off by default; production multi-worker routing is unchanged.
A2A_DEFAULT_AGENT_MODE=

# --- Worker subagent conductor (node-instance orchestration) ----------------
# Per-task budget the node instance may use as the subagent conductor:
# simple tasks run directly; heavy tasks fan out to at most this many
# evidence-only subagents (hard cap 4, single finalizer, disjoint write sets).
WORKER_SUBAGENT_CAP=
# 1 disables injecting the A2A_SUBAGENT_* directive into external handlers.
WORKER_SUBAGENT_DIRECTIVE_DISABLED=
