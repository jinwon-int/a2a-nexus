# brokerbeta→brokeralpha handoff receiver env example.
# Copy to a local, ignored env file before use. Do not commit real secrets,
# private host paths, raw session logs, or generated receiver state.

# Default-off guard: keep disabled until an operator approves the receiver window.
brokerbeta_brokeralpha_RECEIVER_ENABLED=0
brokerbeta_brokeralpha_RECEIVER_MODE=dry-run

# Ownership and routing invariants.
brokerbeta_brokeralpha_BROKER_OF_RECORD=brokeralpha
brokerbeta_brokeralpha_REQUESTED_BY_BROKER=brokerbeta
brokerbeta_brokeralpha_TARGET_TEAM=team1
brokerbeta_brokeralpha_ALLOWED_STATUS_VALUES=accepted,running,pr-open,done,blocked

# Parent GitHub issue or repository watched for structured handoff manifests
# or /a2a assign comments. Keep tokens in the runtime secret store, not here.
brokerbeta_brokeralpha_PARENT_REPO=a2a-plane (internal tracker, private)
brokerbeta_brokeralpha_PARENT_ISSUE=
brokerbeta_brokeralpha_GITHUB_TOKEN=

# Broker URLs use public aliases/placeholders. Replace only in local env.
brokeralpha_BROKER_URL=https://brokeralpha-broker.example.invalid
brokerbeta_BROKER_URL=https://brokerbeta-broker.example.invalid

# Secret values are intentionally blank. Supply from the brokeralpha/brokerbeta runtime
# secret stores or local shell. Never print these in GitHub/chat/artifacts.
brokeralpha_BROKER_EDGE_SECRET=
brokerbeta_BROKER_EDGE_SECRET=

# Durable receiver state. Use a receiver-owned path in the deployed runtime;
# do not point this at a shared worker workspace.
brokerbeta_brokeralpha_RECEIVER_STATE_FILE=/var/lib/a2a-broker/brokerbeta-brokeralpha-receiver/state.sqlite

# Safety defaults for generated brokeralpha tasks.
brokerbeta_brokeralpha_REQUIRE_IDEMPOTENCY_KEY=1
brokerbeta_brokeralpha_REJECT_UNKNOWN_WORKER=1
brokerbeta_brokeralpha_REJECT_WRONG_TARGET_TEAM=1
brokerbeta_brokeralpha_REDACT_SECRETS=1
brokerbeta_brokeralpha_CREATE_TASKS=0

# Read-only package checks.
# npm run brokerbeta_brokeralpha_receiver_preflight -- --brokeralpha-url "$brokeralpha_BROKER_URL" --brokerbeta-url "$brokerbeta_BROKER_URL" --json
# npm run brokerbeta_brokeralpha_receiver_receipt_parity -- --brokeralpha-url "$brokeralpha_BROKER_URL" --brokerbeta-url "$brokerbeta_BROKER_URL" --brokeralpha-edge-secret "$brokeralpha_BROKER_EDGE_SECRET" --brokerbeta-edge-secret "$brokerbeta_BROKER_EDGE_SECRET" --limit 20 --json
