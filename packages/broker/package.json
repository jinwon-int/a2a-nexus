{
  "name": "a2a-broker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Minimal standalone A2A broker scaffold",
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/generate-build-info.mjs",
    "check": "tsc -b tsconfig.json",
    "test": "node scripts/run-test-manifest.mjs",
    "test:drift-watch": "npx tsx --test src/a2a/protocol-compatibility.test.ts src/a2a/drift-watch.test.ts",
    "refresh:drift-refs": "node scripts/refresh-drift-refs.mjs",
    "tck:self-check": "npm run build && node scripts/a2a-tck-harness.mjs --self-check",
    "tck:run": "npm run build && node scripts/a2a-tck-harness.mjs",
    "tck:history:append": "node scripts/append-tck-history.mjs",
    "tck:check-regressions": "node scripts/check-tck-regressions.mjs",
    "reconcile_closeout": "node scripts/closeout-reconcile.mjs",
    "terminal_brief": "node scripts/terminal-brief.mjs",
    "test:worker": "npm run build && node --test dist/worker.test.js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "smoke:restart-recovery": "node scripts/restart-recovery-smoke.mjs",
    "smoke:docker-broker": "node scripts/docker-broker-live-smoke.mjs",
    "smoke:docker-broker:fleet": "node scripts/docker-broker-live-smoke.mjs --fleet --require-workers workergamma,workerepsilon,workerbeta,workeralpha",
    "export:sqlite": "node scripts/export-sqlite-state.mjs",
    "dev": "node --watch --enable-source-maps src/server.ts",
    "dev:worker": "node --watch --enable-source-maps src/worker.ts",
    "release_gate": "node scripts/release-gate.mjs",
    "scripts_inventory": "node scripts/npm-scripts-inventory.mjs",
    "docker_runtime_preflight": "node scripts/docker-runtime-preflight.mjs",
    "rollout_guard": "node scripts/worker-artifact-rollout-guard.mjs",
    "worker_signature_rollout_preflight": "node scripts/worker-http-signature-rollout-preflight.mjs",
    "terminal_outbox_preflight": "node scripts/terminal-outbox-preflight.mjs",
    "live_readiness_canary": "node scripts/broker-live-readiness-canary.mjs",
    "receipt_gate_canary": "node scripts/receipt-gate-canary.mjs",
    "terminal_outbox_backlog_classifier": "node scripts/terminal-receipt-closeout-report.mjs",
    "terminal_outbox_cleanup_dryrun": "node scripts/terminal-receipt-closeout-report.mjs",
    "lifecycle_proof_evidence": "node scripts/broker-lifecycle-proof-evidence.mjs",
    "migration_health_gate": "node scripts/broker-migration-health-gate.mjs",
    "work_mode_pre_dispatch_decision": "npm run build && node scripts/work-mode-pre-dispatch-decision.mjs",
    "test:work_mode_pre_dispatch_decision": "npx tsx --test src/core/work-mode-pre-dispatch-decision.test.ts",
    "adaptive_work_mode_selector": "npm run build && node scripts/adaptive-work-mode-selector.mjs",
    "test:adaptive_work_mode_selector": "npx tsx --test src/core/adaptive-work-mode-selector.test.ts",
    "a2a_hybrid_worker_mode_benchmark": "node scripts/a2a-hybrid-worker-mode-benchmark.mjs",
    "worker_subagent_orchestration_policy": "npm run build && node scripts/worker-subagent-orchestration-policy.mjs",
    "worker_self_assessment_capacity": "npm run build && node scripts/worker-self-assessment-capacity.mjs",
    "worker_subagent_planner_handoff": "npm run build && node scripts/worker-subagent-planner-handoff.mjs",
    "worker_subagent_spawn_authorization_request": "npm run build && node scripts/worker-subagent-spawn-authorization-request.mjs",
    "worker_subagent_budget_counter": "npm run build && node scripts/worker-subagent-budget-counter.mjs",
    "worker_subagent_spawn_gate_decision": "npm run build && node scripts/worker-subagent-spawn-gate-decision.mjs",
    "worker_subagent_evidence_assembly": "npm run build && node scripts/worker-subagent-evidence-assembly.mjs",
    "worker_subagent_context_brief": "npm run build && node scripts/worker-subagent-context-brief.mjs",
    "worker_subagent_redaction_gate": "npm run build && node scripts/worker-subagent-redaction-gate.mjs",
    "orchestration_intelligence_worker_spawn_approval_decision_evidence": "npm run build && node scripts/orchestration-intelligence-worker-spawn-approval-decision-evidence.mjs",
    "orchestration_intelligence_worker_subagent_spawn_authorization_bridge": "npm run build && node scripts/orchestration-intelligence-worker-subagent-spawn-authorization-bridge.mjs",
    "complexity_orchestration_recommendation": "npm run build && node scripts/complexity-orchestration-recommendation.mjs",
    "test:execution-plan-draft": "npx tsx --test src/core/complexity-execution-plan-draft.test.ts",
    "complexity_execution_plan_draft": "npm run build && node scripts/complexity-execution-plan-draft.mjs",
    "test:operator-approval-request": "npx tsx --test src/core/operator-approval-request.test.ts",
    "operator_approval_request": "npm run build && node scripts/operator-approval-request.mjs",
    "complexity_execution_plan_preflight_seal": "npm run build && node scripts/complexity-execution-plan-preflight-seal.mjs",
    "mobile_worker_preflight": "npm run build && node scripts/mobile-worker-preflight.mjs",
    "broker_cleanup_safe_prune": "npm run build && node scripts/broker-cleanup-safe-prune.mjs",
    "test:terminal_brief_activation_report": "node --test scripts/terminal-brief-activation-report.test.mjs",
    "scan:public-readiness": "node scripts/public-readiness-scan.mjs",
    "two_broker_worker_preflight": "node scripts/two-broker-worker-preflight.mjs",
    "edge_secret_rotation_diagnostics": "node scripts/edge-secret-rotation-diagnostics.mjs",
    "test:edge_secret_rotation_diagnostics": "node --test scripts/edge-secret-rotation-diagnostics.test.mjs",
    "release_evidence_export": "npm run build && node dist/release-evidence-export.js",
    "orchestration_intelligence_validation_framework": "npm run build && node scripts/orchestration-intelligence-validation-framework.mjs",
    "orchestration_intelligence_validation_scorer": "npm run build && node scripts/orchestration-intelligence-validation-scorer.mjs",
    "orchestration_intelligence_validation_finalizer_review": "npm run build && node scripts/orchestration-intelligence-validation-finalizer-review.mjs",
    "orchestration_intelligence_validation_operator_review_request": "npm run build && node scripts/orchestration-intelligence-validation-operator-review-request.mjs",
    "orchestration_intelligence_validation_operator_decision_evidence": "npm run build && node scripts/orchestration-intelligence-validation-operator-decision-evidence.mjs",
    "orchestration_intelligence_validation_finalizer_decision": "npm run build && node scripts/orchestration-intelligence-validation-finalizer-decision.mjs",
    "orchestration_intelligence_runtime_readiness_gate": "npm run build && node scripts/orchestration-intelligence-runtime-readiness-gate.mjs",
    "orchestration_intelligence_runtime_design_review": "npm run build && node scripts/orchestration-intelligence-runtime-design-review.mjs",
    "orchestration_intelligence_runtime_approval_request": "npm run build && node scripts/orchestration-intelligence-runtime-approval-request.mjs",
    "orchestration_intelligence_runtime_approval_decision_evidence": "npm run build && node scripts/orchestration-intelligence-runtime-approval-decision-evidence.mjs",
    "orchestration_intelligence_broker_dispatch_approval_request": "npm run build && node scripts/orchestration-intelligence-broker-dispatch-approval-request.mjs",
    "orchestration_intelligence_broker_dispatch_approval_decision_evidence": "npm run build && node scripts/orchestration-intelligence-broker-dispatch-approval-decision-evidence.mjs",
    "orchestration_intelligence_worker_spawn_approval_request": "npm run build && node scripts/orchestration-intelligence-worker-spawn-approval-request.mjs",
    "team1_dispatch_wrapper": "npm run build && node scripts/team1-dispatch-wrapper.mjs",
    "a2a_dispatch_helper": "npm run build && node scripts/a2a-dispatch-helper.mjs",
    "team2_dispatch_helper": "npm run build && node scripts/a2a-dispatch-helper.mjs --team-id team2",
    "round_manifest": "npm run build && node scripts/round-manifest.mjs",
    "round_parent_aggregate_report": "npm run build && node scripts/round-parent-aggregate-report.mjs",
    "a2a_dialectic_lite_finalizer": "npm run build && node scripts/a2a-dialectic-lite-finalizer.mjs",
    "round_coordinator_closeout_dry_run": "node scripts/round-coordinator-closeout-dry-run.mjs",
    "test:round_coordinator_closeout_dry_run": "node --test scripts/round-coordinator-closeout-dry-run.test.mjs",
    "livez_stall_measure": "node scripts/broker-livez-stall-attribution.mjs --no-live --markdown",
    "livez_stall_measure_live": "node scripts/broker-livez-stall-attribution.mjs --markdown",
    "test:livez-stall": "node --test scripts/broker-livez-stall-attribution.test.mjs",
    "comprehensive_diagnostics": "node scripts/broker-comprehensive-diagnostics.mjs --no-live --markdown",
    "comprehensive_diagnostics_live": "node scripts/broker-comprehensive-diagnostics.mjs --markdown",
    "test:comprehensive-diagnostics": "node --test scripts/broker-comprehensive-diagnostics.test.mjs",
    "start:local": "mkdir -p .local && HOST=127.0.0.1 PORT=8787 PUBLIC_BASE_URL=http://127.0.0.1:8787 STATE_FILE=.local/state.json STALE_REAPER_ENABLED=0 npm run start",
    "worker:echo": "BROKER_URL=${LOCAL_A2A_BROKER_URL:-http://127.0.0.1:8787} WORKER_ID=${LOCAL_A2A_WORKER_ID:-local-echo-worker} WORKER_DISPLAY_NAME=${LOCAL_A2A_WORKER_DISPLAY_NAME:-Local Echo Worker} WORKER_HANDLER_BUILTIN=echo WORKER_POLL_INTERVAL_MS=1000 WORKER_HEARTBEAT_INTERVAL_MS=5000 npm run start:worker",
    "a2ad_evidence_classifier": "node scripts/a2ad-evidence-classifier.mjs",
    "worker_compatibility_audit": "node scripts/worker-compatibility-audit.mjs",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "coverage:baseline": "npm run build && node --test scripts/coverage-baseline-report.test.mjs && node scripts/coverage-baseline-report.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "zod": "^4.3.6",
    "a2a-policy-referee": "0.1.0",
    "a2a-attestation": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinwon-int/a2a-nexus.git",
    "directory": "packages/broker"
  },
  "homepage": "https://github.com/jinwon-int/a2a-nexus/tree/main/packages/broker#readme",
  "bugs": {
    "url": "https://github.com/jinwon-int/a2a-nexus/issues"
  }
}
