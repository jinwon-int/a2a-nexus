{
  "name": "a2a-policy-referee",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Declarative worker-class policy engine for A2A brokers (warn/enforce)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinwon-int/a2a-nexus.git",
    "directory": "packages/policy-referee"
  },
  "homepage": "https://github.com/jinwon-int/a2a-nexus/tree/main/packages/policy-referee",
  "bugs": {
    "url": "https://github.com/jinwon-int/a2a-nexus/issues"
  },
  "files": [
    "dist",
    "fixtures",
    "scripts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "a2a-policy-referee": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/**/*.test.js",
    "fixtures:replay": "node scripts/replay-golden-fixtures.mjs",
    "coverage:baseline": "npm run build && node scripts/coverage-baseline-report.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  }
}
