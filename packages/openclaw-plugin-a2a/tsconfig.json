{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true
  },
  "include": [
    "./test/shims/openclaw-plugin-sdk.d.ts",
    "./*.ts",
    "./src/**/*.ts"
  ],
  "exclude": [
    "./dist/**",
    "./node_modules/**",
    "./**/*.test.ts",
    "./tests/**"
  ]
}
