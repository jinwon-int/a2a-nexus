{
  "name": "plugin-a2a",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Standalone A2A broker adapter plugin",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp openclaw.plugin.json dist/openclaw.plugin.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test src/**/*.test.ts ./*.test.ts test/*.test.mjs tests/*.test.ts",
    "coverage:baseline": "npm run build && node --test scripts/coverage-baseline-report.test.mjs && node scripts/coverage-baseline-report.mjs",
    "test:gateway": "rm -rf dist && tsc -p tsconfig.gateway-verify.json && node --test src/**/*.test.ts ./*.test.ts test/*.test.mjs",
    "preflight:canary:receipt-gated": "scripts/canary-receipt-gated-preflight.sh",
    "smoke:a2a-conformance": "scripts/smoke-a2a-conformance.sh",
    "scan:public-readiness": "scripts/scan-public-readiness.sh",
    "prepack": "npm run scan:public-readiness && npm run build"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "^8.18.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "openclaw": "file:test/fixtures/openclaw",
    "typescript": "^6.0.3"
  },
  "main": "./dist/index.js",
  "bin": {
    "a2a-terminal-brief-sidecar": "./dist/terminal-brief-sidecar.js",
    "a2a-terminal-brief-openclaw-message": "./dist/terminal-brief-openclaw-message.js",
    "a2a-terminal-brief-hermes-mobileAlpha": "./dist/terminal-brief-hermes-mobileAlpha.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./standalone-broker-client": {
      "types": "./dist/standalone-broker-client.d.ts",
      "default": "./dist/standalone-broker-client.js"
    },
    "./type-mapping": {
      "types": "./dist/type-mapping.d.ts",
      "default": "./dist/type-mapping.js"
    },
    "./plugin-id": {
      "types": "./dist/plugin-id.d.ts",
      "default": "./dist/plugin-id.js"
    },
    "./src/*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs/agent-card-discovery.md",
    "docs/alpha-boundaries.md",
    "docs/a2a-agent-card.local.json",
    "docs/compatibility-matrix.md",
    "docs/public-stable-readiness.md",
    "docs/remote-handoff-visibility-policy.md",
    "docs/operator-terminal-notification-receipts.md",
    "docs/terminal-brief-delivery-adapter-contract.md",
    "docs/terminal-brief-sidecar.md",
    "docs/termux-mobile-smoke-test.md",
    "docs/termux-troubleshooting.md"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinwon-int/a2a-nexus.git",
    "directory": "packages/openclaw-plugin-a2a"
  },
  "homepage": "https://github.com/jinwon-int/a2a-nexus/tree/main/packages/openclaw-plugin-a2a#readme",
  "bugs": {
    "url": "https://github.com/jinwon-int/a2a-nexus/issues"
  },
  "engines": {
    "node": ">=22.5"
  }
}
