{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewLineageObservationEnvelopeV1",
  "description": "Lossless, replay-safe source observation for one bounded PR review lineage. This is a pure record-mode input contract; it grants no broker/store mutation authority.",
  "type": "object",
  "required": [
    "kind",
    "producerId",
    "sourceEventId",
    "lineageId",
    "observedAt",
    "binding",
    "observation"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "a2a.review-lineage-observation.v1"
    },
    "producerId": {
      "$ref": "#/definitions/identifier"
    },
    "sourceEventId": {
      "$ref": "#/definitions/identifier"
    },
    "lineageId": {
      "$ref": "#/definitions/identifier"
    },
    "observedAt": {
      "$ref": "#/definitions/utcTimestamp"
    },
    "binding": {
      "$ref": "#/definitions/subjectBinding"
    },
    "observation": {
      "oneOf": [
        { "$ref": "#/definitions/lineageCreate" },
        { "$ref": "#/definitions/reviewReport" },
        { "$ref": "#/definitions/correctionGeneration" },
        { "$ref": "#/definitions/reviewerReplacement" },
        { "$ref": "#/definitions/operatorCancel" }
      ]
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "subjectBinding": {
      "type": "object",
      "required": ["intentHash", "headSha", "diffHash"],
      "additionalProperties": false,
      "properties": {
        "intentHash": { "$ref": "#/definitions/hash" },
        "headSha": { "$ref": "#/definitions/sha" },
        "diffHash": { "$ref": "#/definitions/hash" }
      }
    },
    "lineageCreate": {
      "type": "object",
      "required": ["kind", "mode", "contract", "budget"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "lineage_create" },
        "mode": { "const": "record" },
        "contract": { "$ref": "intent-contract-v1.json" },
        "budget": { "$ref": "review-lineage-budget-v1.json" }
      }
    },
    "reviewReport": {
      "type": "object",
      "required": [
        "kind",
        "receipt",
        "resolvedFindingIds",
        "reopenedFindingIds",
        "newFindings"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "review_report" },
        "receipt": { "$ref": "review-receipt-v1.json" },
        "resolvedFindingIds": {
          "$ref": "#/definitions/findingIdArray"
        },
        "reopenedFindingIds": {
          "$ref": "#/definitions/findingIdArray"
        },
        "newFindings": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/definitions/newFinding" }
        }
      }
    },
    "findingIdArray": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^F-[0-9]+$"
      }
    },
    "newFinding": {
      "type": "object",
      "required": [
        "findingId",
        "criterionRef",
        "evidenceRefs",
        "severity",
        "category",
        "blocking",
        "introducedAtHead",
        "firstSeenAtHead",
        "resolvedAtHead",
        "disposition",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^F-[0-9]+$"
        },
        "criterionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "severity": {
          "enum": ["critical", "major", "minor"]
        },
        "category": {
          "enum": [
            "correctness",
            "security",
            "regression",
            "spec_ambiguity",
            "scope_drift",
            "style",
            "preference",
            "design",
            "other"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "introducedAtHead": {
          "$ref": "#/definitions/sha"
        },
        "firstSeenAtHead": {
          "$ref": "#/definitions/sha"
        },
        "resolvedAtHead": {
          "oneOf": [
            { "$ref": "#/definitions/sha" },
            { "type": "null" }
          ]
        },
        "disposition": {
          "enum": [
            "open",
            "resolved",
            "reopened",
            "overruled_by_finalizer"
          ]
        },
        "signature": {
          "$ref": "#/definitions/hash"
        },
        "justification": {
          "$ref": "#/definitions/newFindingJustification"
        }
      }
    },
    "newFindingJustification": {
      "type": "object",
      "required": ["kind", "detail"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "introduced_regression",
            "critical_security",
            "unavailable_evidence"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "correctionGeneration": {
      "type": "object",
      "required": [
        "kind",
        "headSha",
        "diffHash",
        "intentHash",
        "pathsChanged"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "correction_generation" },
        "headSha": { "$ref": "#/definitions/sha" },
        "diffHash": { "$ref": "#/definitions/hash" },
        "intentHash": { "$ref": "#/definitions/hash" },
        "pathsChanged": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "reviewerReplacement": {
      "type": "object",
      "required": ["kind", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "reviewer_replacement" },
        "reason": {
          "enum": ["infrastructure_failure", "other"]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "operatorCancel": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "operator_cancel" },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
