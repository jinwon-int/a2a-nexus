        { "path": "a2adEvidence.primaryRound", "equals": "a2ad-active-provenance-mirror-20260610T155109Z", "message": "primary A2AD round" },
        { "path": "a2adEvidence.focusedTeam1RetryRound", "equals": "a2ad-active-provenance-mirror-team1-retry-20260610T155535Z", "message": "focused retry round" },
        { "path": "a2adEvidence.usableAnalysisCount", "equals": 6, "message": "usable analysis count" },
        { "path": "a2adEvidence.workers", "arraySome": { "worker": "sogyo", "status": "succeeded", "analysisStatus": "done" }, "message": "sogyo evidence" },
        { "path": "a2adEvidence.workers", "arraySome": { "worker": "nosuk", "status": "succeeded", "analysisStatus": "done" }, "message": "nosuk evidence" },
        { "path": "a2adEvidence.workers", "arraySome": { "worker": "bangtong", "status": "succeeded", "analysisStatus": "done" }, "message": "bangtong evidence" },
        { "path": "a2adEvidence.workers", "arraySome": { "worker": "dungae", "status": "succeeded", "analysisStatus": "done" }, "message": "dungae evidence" },
        { "path": "a2adEvidence.workers", "arraySome": { "worker": "jingun", "status": "succeeded", "analysisStatus": "done" }, "message": "jingun evidence" },
        { "path": "a2adEvidence.workers", "arraySome": { "worker": "soonwook", "status": "succeeded", "analysisStatus": "done" }, "message": "soonwook evidence" },
        { "path": "executionGates.operatorApprovalPhraseMatched", "equals": true, "message": "approval gate" },
        { "path": "executionGates.splitRepoPrsMerged", "equals": true, "message": "split repo PR merge gate" },
        { "path": "executionGates.externalSettingsMutationPerformed", "equals": false, "message": "settings mutation gate" },
        { "path": "boundaries.docsOnlyMirrorNotice", "equals": true, "message": "docs-only mirror boundary" },
        { "path": "goNoGoFields.decision", "equals": "GO_EXECUTED_DOCS_ONLY_ACTIVE_PROVENANCE_MIRROR__EXTERNAL_SURFACES_HOLD", "message": "GO/NO-GO decision" },
