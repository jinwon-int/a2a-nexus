      },
      "releaseGateStep": {
        "name": "monorepo-active-provenance-mirror-execution-result",
        "tier": "historical-transition",
        "args": ["run", "check:monorepo-active-provenance-mirror-execution-result"]
      },
      "assertions": [
        { "path": "schema", "equals": "a2a.monorepo-active-provenance-mirror-execution-result.v1", "message": "fixture schema" },
