{
  "$schema": "https://example.invalid/a2a-nexus/data-driven-validation-registry.schema.json",
  "purpose": "Initial #882 data-driven validation registry. Each entry drives a thin scripts/check-*.mjs wrapper through scripts/lib/doc-spec-check.mjs, keeping the historical script names stable while moving repeated doc/fixture/package/release-gate assertions into data.",
  "checks": [
    {
