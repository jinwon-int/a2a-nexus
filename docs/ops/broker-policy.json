{
  "schemaVersion": "a2a.broker.policy.v1",
  "mode": "warn",
  "defaultAction": "allow",
  "rules": [
    {
      "id": "mobile-analyze-only",
      "workerClass": "mobile",
      "allowIntents": [
        "analyze"
      ],
      "denyModes": [
        "github-propose-patch",
        "propose-patch",
        "patch"
      ],
      "maxTasksPerDay": 20
    },
    {
      "id": "source-only-safe-intents",
      "workerClass": "source-only",
      "allowIntents": [
        "analyze",
        "verify",
        "propose_patch"
      ],
      "denyModes": [
        "github-propose-patch",
        "patch"
      ]
    }
  ]
}