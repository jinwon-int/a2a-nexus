# Cross-broker Terminal Brief receiver environment (one file per direction).
# Copy to /etc/a2a/cross-broker-receiver/<direction>.env and chmod 0600.
# NEVER commit a filled-in copy; secrets stay on the host, file-based, root-only.
#
# Reverse-direction example values are shown (source=brokeralpha child
# producer, destination=brokerbeta parent ledger). For the forward direction
# swap the source/destination pairs and use a DIFFERENT cursor file.

# Default-off safety switch: the unit exits immediately without this.
CROSS_BROKER_TERMINAL_BRIEF_RECEIVER_ENABLED=1

# --- Direction -----------------------------------------------------------
# Broker that produced the child terminal events (child broker of record).
CROSS_BROKER_SOURCE_BROKER_ID=brokeralpha
CROSS_BROKER_SOURCE_BASE_URL=http://127.0.0.1:18787
# Broker that owns the parent round ledger (this host).
CROSS_BROKER_DEST_BROKER_ID=brokerbeta
CROSS_BROKER_DEST_BASE_URL=http://127.0.0.1:8787

# --- Cursor (unique per direction; survives restarts) --------------------
CROSS_BROKER_CURSOR_FILE=/var/lib/a2a-cross-broker-terminal-brief-receiver/brokeralpha-to-brokerbeta.cursor.json

# --- Poll shape ----------------------------------------------------------
CROSS_BROKER_POLL_INTERVAL_MS=3000
CROSS_BROKER_LIMIT=50
CROSS_BROKER_RECONCILE_UNACKED=1
CROSS_BROKER_REQUESTER_ID=brokerbeta-cross-broker-terminal-brief-receiver
CROSS_BROKER_REQUESTER_ROLE=hub

# --- Edge secrets (transport gate; file-based values preferred) ----------
# Populate from root-only files in the unit's ExecStartPre or use the peer
# credentials below; do not paste raw secrets into this file in production.
CROSS_BROKER_SOURCE_EDGE_SECRET=
CROSS_BROKER_DEST_EDGE_SECRET=

# --- Minimum-scope peer credentials (broker-handoff-protocol.md) ---------
# Source side needs only handoff:status; destination side only
# handoff:evidence. Secret FILES must be root-only (0600); the runner fails
# closed otherwise and never logs the values.
CROSS_BROKER_SOURCE_PEER_BROKER_ID=brokerbeta
CROSS_BROKER_SOURCE_PEER_SECRET_FILE=/etc/a2a/cross-broker-receiver/secrets/source-peer.secret
CROSS_BROKER_DEST_PEER_BROKER_ID=brokeralpha
CROSS_BROKER_DEST_PEER_SECRET_FILE=/etc/a2a/cross-broker-receiver/secrets/dest-peer.secret

# --- Sender proof (required once the destination pins this sender's key) --
CROSS_BROKER_SENDER_PROOF_PRIVATE_KEY_FILE=/etc/a2a/cross-broker-receiver/secrets/sender-proof-key.pem
# Defaults to CROSS_BROKER_SOURCE_BROKER_ID when unset.
CROSS_BROKER_SENDER_PROOF_BROKER_ID=
CROSS_BROKER_SENDER_PROOF_KID=
