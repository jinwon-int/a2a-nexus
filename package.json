    "scan:external-secrets": "node scripts/external-secret-scan.mjs",
    "libero:public-preflight-closeout": "node scripts/libero-public-preflight-closeout.mjs",
    "a2a:taskflow-runtime": "node scripts/a2a-spec-first-taskflow-runtime.mjs --spec docs/taskflow/a2a-spec-first-runtime-schema.json",
    "a2a:taskflow-runtime:test": "node --test scripts/a2a-spec-first-taskflow-runtime.test.mjs",
    "test": "npm run check",
    "test:release-gate": "node scripts/run-release-gate.mjs",
    "test:release-gate:list": "node scripts/run-release-gate.mjs --list",
    "test:conformance": "node test/conformance/run-conformance.mjs",
    "round:merge-preflight": "node scripts/round-merge-preflight.mjs",
    "a2a:execution-orchestrator": "node scripts/a2a-source-public-execution-orchestrator.mjs --spec docs/execution-orchestrator/source-public-execution-orchestrator-schema.json",
    "a2a:execution-orchestrator:test": "node --test scripts/a2a-source-public-execution-orchestrator.test.mjs",
    "a2a:team2-source-approval-rehearsal": "node scripts/a2a-team2-source-public-approval-rehearsal.mjs --spec docs/approval-rehearsal/team2-worker-eta-source-public-approval-rehearsal-schema.json",
    "a2a:team2-source-approval-rehearsal:test": "node --test scripts/check-team2-source-public-approval-rehearsal.test.mjs",
    "a2a:final-go-nogo-gate": "node scripts/a2a-source-public-final-go-nogo-gate.mjs --spec docs/final-approval/source-public-final-go-nogo-gate-schema.json",
    "a2a:final-go-nogo-gate:test": "node --test scripts/a2a-source-public-final-go-nogo-gate.test.mjs",
    "check:allhands-stability-closeout-gates": "node --test scripts/check-a2a-allhands-stability-closeout-gates.test.mjs",
    "check:a2a-nexus-842-advisory-sidecar-closeout-readiness-matrix": "node --test scripts/check-a2a-nexus-842-advisory-sidecar-closeout-readiness-matrix.test.mjs",
    "check:team1-dispatch-wrapper-runbook": "node --test scripts/check-team1-dispatch-wrapper-runbook.test.mjs",
    "check:team1-dispatch-guard": "node --test scripts/a2a-team1-dispatch-guard.test.mjs",
    "a2a:team1-dispatch-guard": "node scripts/a2a-team1-dispatch-guard.mjs --input",
    "fleet:routing-guard": "node scripts/a2a-fleet-routing-guard.mjs",
    "fleet:routing-guard:test": "node --test scripts/a2a-fleet-routing-guard.test.mjs",
    "routing:broker-id": "node scripts/a2a-broker-id-routing.mjs",
    "routing:broker-id:test": "node --test scripts/a2a-broker-id-routing.test.mjs",
    "routing:shared:test": "node --test scripts/a2a-routing-shared.test.mjs",
    "worker:readiness-preflight": "node scripts/a2a-worker-readiness-preflight.mjs",
    "worker:readiness-preflight:test": "node --test scripts/a2a-worker-readiness-preflight.test.mjs",
    "check:repo-protection-baseline": "node scripts/check-repo-protection-baseline.mjs",
    "check:repo-protection-baseline:test": "node --test scripts/check-repo-protection-baseline.test.mjs",
    "pr-review:healthcheck": "node scripts/pr-review-healthcheck.mjs",
    "dispatch:round": "node scripts/a2a-dispatch-round.mjs",
    "dispatch:round:test": "node --test scripts/a2a-dispatch-round.test.mjs",
    "safety:body": "node scripts/a2a-body-safety-scan.mjs",
    "safety:body:test": "node --test scripts/a2a-safe-body.test.mjs",
    "dispatch:round:coordinator": "node scripts/round-coordinator-dispatch.mjs",
    "dispatch:round:coordinator:test": "node --test scripts/round-coordinator-dispatch.test.mjs",
    "finalizer:gate": "node scripts/a2ad-finalizer-gate.mjs",
    "finalizer:gate:test": "node --test scripts/a2ad-finalizer-gate.test.mjs test/review-lineage-finalizer-evidence.test.mjs",
    "check:markdown-links": "node scripts/check-markdown-links.mjs",
    "check:ci-docs-safety": "node --test scripts/ci-docs-safety.test.mjs",
    "a2a:skill-guard": "node scripts/a2a-skill-guard.mjs",
    "a2a:skill-guard:test": "node --test scripts/a2a-skill-guard.test.mjs",
    "check:approval-records": "node scanner/readiness/check-approval-records.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "^8.18.0"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  },
  "engines": {
    "node": ">=22.5"
  }
}
