{
  "name": "@jinwon-int/a2a-nexus-monorepo",
  "private": true,
  "description": "Public-readiness alpha A2A Nexus monorepo workspace for broker, adapter plugin, Docker runner, contracts, docs, and examples; visibility changes and package publication remain approval-gated.",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "check": "npm run release-gate",
    "smoke:quickstart": "npm run build && npm run check:quickstart-conformance && npm run check:quickstart-doctest && npm run check:promotion-capstone && npm run check:external-harness-conformance && npm run test:release-gate",
    "release-gate": "node scripts/release-gate.mjs",
    "check:release-gate-inventory": "node scripts/check-release-gate-step-inventory.mjs && node --test scripts/release-gate-tiering.test.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "review:check": "node scripts/review-worktree-check.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:promotion-capstone": "node scripts/check-promotion-capstone-conformance.mjs",
    "check:runner-import-smoke": "node scripts/check-runner-import-smoke.mjs",
    "check:terminal-brief-routing": "node scripts/check-terminal-brief-routing.mjs",
    "check:message-id-ack-boundary": "node scripts/check-message-id-ack-boundary.mjs",
    "check:compatibility-baselines": "node scripts/check-compatibility-baselines.mjs",
    "check:quickstart-conformance": "node scripts/check-quickstart-conformance.mjs",
    "check:quickstart-doctest": "node scripts/check-quickstart-doctest.mjs",
    "check:external-harness-conformance": "node scripts/check-external-harness-conformance.mjs",
    "check:hermes-reference-worker": "node --test scripts/check-hermes-reference-worker.test.mjs",
    "check:native-worker-conformance": "node --test scripts/check-native-worker-conformance.test.mjs",
    "check:no-diff-closeout-guidance": "node --test scripts/check-no-diff-closeout-guidance.test.mjs",
    "check:current-state-no-live-smoke": "node scripts/check-current-state-no-live-integration-smoke.mjs",
    "check:monorepo-docs-routing": "node scripts/check-monorepo-docs-routing.mjs",
    "check:readme-canonical-surface": "node scripts/check-readme-canonical-surface.mjs",
    "check:broker-core-dependency-isolation": "node scripts/check-broker-core-dependency-isolation.mjs",
    "check:script-budget": "node scripts/check-script-budget.mjs",
    "check:source-quality-floors": "node scripts/check-source-quality-floors.mjs",
    "scan:public-readiness": "node scripts/public-readiness-scan.mjs --strict-internal",
    "scan:readiness-gates": "node scanner/readiness/fail-closed-gates.mjs --spec docs/readiness/fail-closed-gates.json",
    "scan:external-secrets": "node scripts/external-secret-scan.mjs",
    "a2a:source-public-preflight-closeout": "node scripts/libero-public-preflight-closeout.mjs",
    "a2a:taskflow-runtime": "node scripts/a2a-spec-first-taskflow-runtime.mjs --spec docs/taskflow/a2a-spec-first-runtime-schema.json",
    "a2a:taskflow-runtime:test": "node --test scripts/a2a-spec-first-taskflow-runtime.test.mjs",
    "test": "npm run check",
    "test:release-gate": "node scripts/run-release-gate.mjs",
    "test:release-gate:list": "node scripts/run-release-gate.mjs --list",
    "test:conformance": "node test/conformance/run-conformance.mjs",
    "round:merge-preflight": "node scripts/round-merge-preflight.mjs",
    "check:allhands-stability-closeout-gates": "node --test scripts/check-a2a-allhands-stability-closeout-gates.test.mjs",
    "fleet:routing-guard": "node scripts/a2a-fleet-routing-guard.mjs",
    "check:repo-protection-baseline": "node scripts/check-repo-protection-baseline.mjs",
    "pr-review:healthcheck": "node scripts/pr-review-healthcheck.mjs",
    "dispatch:round": "node scripts/a2a-dispatch-round.mjs",
    "dispatch:round:test": "node --test scripts/a2a-dispatch-round.test.mjs",
    "check:markdown-links": "node scripts/check-markdown-links.mjs",
    "check:ci-docs-safety": "node --test scripts/ci-docs-safety.test.mjs",
    "check:approval-records": "node scanner/readiness/check-approval-records.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "engines": {
    "node": ">=22.5"
  }
}
